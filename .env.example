# Copy to .env for local development. Placeholders only — never commit real values.
NODE_ENV=development
PORT=3000
# Public base URL used in emails and as the default allowed Origin (https in production).
APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the API with cookies (defaults to APP_URL's origin).
ALLOWED_ORIGINS=http://localhost:3000
# Set when running behind a reverse proxy (needed for correct client IPs in rate limits).
TRUST_PROXY=false

# PostgreSQL. Leave unset in development to use the embedded PostgreSQL started by `npm run dev`.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/mihmah

# Sessions (HttpOnly cookie). COOKIE_SECURE defaults to true in production and cannot be disabled there.
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=48
# COOKIE_SECURE=true

# HMAC key for short-lived download links (32+ random characters; required in production).
FILE_URL_SECRET=replace-with-32+-random-characters
FILE_URL_TTL_SECONDS=120
MAX_UPLOAD_MB=10

# Email: "dev" writes to storage/dev-mail (view at /dev/mail); production requires "smtp".
MAIL_PROVIDER=dev
MAIL_FROM="Mihmah <no-reply@your-domain.example>"
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Private file storage: "local" (development only) or "s3" (any S3-compatible bucket; required in production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/private
# S3_ENDPOINT=https://s3.your-provider.example
# S3_REGION=your-region
# S3_BUCKET=your-private-bucket
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_FORCE_PATH_STYLE=true

# Payments: "none" (default; no money movement, status pending integration) or "sandbox" (development/demo only).
# No live provider is integrated — see PAYMENTS-RESEARCH.md.
PAYMENTS_PROVIDER=none
PLATFORM_FEE_PERCENT=10

OFFER_TTL_HOURS=72

# Demo environment only (separate database!): enables one-click demo logins for is_demo accounts.
DEMO_MODE=false
# Password for seeded fictional accounts (development/demo seed only).
# SEED_PASSWORD=choose-a-demo-password
